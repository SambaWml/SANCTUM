# Copie para .env. Nunca commite o .env.
# Use aspas em valores com # ou espaços: SENHA="ab#cd" (sem aspas, o # vira comentário e corta o valor).
# As variáveis de cada ambiente são referenciadas em config/environments.yaml.
# O /qa pede o que faltar antes de abrir o navegador.

# App fixture local (npm run fixture), usuário "admin":
FIXTURE_ADMIN_PASSWORD=

# Opcional: usar o Chrome instalado em vez do Chromium do Playwright
# SANCTUM_BROWSER_CHANNEL=chrome

# Site do Jira (links do painel), ex.: https://sua-empresa.atlassian.net
# SANCTUM_JIRA_URL=

# Exemplo (ambiente "loja-hml" em config/environments.local.yaml, papel "admin"):
# LOJA_HML_ADMIN_PASSWORD=
